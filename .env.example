# أسماء المتغيرات فقط — لا تضع قيمًا حقيقية في المستودع.
# Vercel: Project ← Settings ← Environment Variables. غيابها يُفشل بناء الإنتاج عمدًا.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# مفتاح anon / publishable فقط (عام ومحمي بـ RLS). ممنوع service_role / sb_secret_.
SUPABASE_ANON_KEY=
# محليًا فقط: RAZI_DEMO=1 يُظهر بيانات تجريبية مع شريط أحمر. ممنوع في Vercel (يُفشل البناء).
# RAZI_DEMO=1

# اختبار التكامل (tests/supabase.integration.mjs) على مشروع Supabase *اختباري* فقط — من البيئة، لا من الملفات:
# TEST_ADMIN_EMAIL=  TEST_ADMIN_PASSWORD=  TEST_USER_EMAIL=  TEST_USER_PASSWORD=

# ===== مساعد الرازي (Gemini) — الخادم فقط (دالة api/assistant.js). لا تُحقن في المتصفح ولا في js/config.js =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# اختياري — حدود الاستعمال (القيم الافتراضية 6 طلبات/دقيقة/IP و400 طلب/يوم/نسخة):
# ASSISTANT_RATE_LIMIT_PER_MIN=6
# ASSISTANT_DAILY_LIMIT=400
# ASSISTANT_ALLOWED_ORIGINS=https://your-domain.example   (أصول إضافية مسموحة، مفصولة بفواصل؛ نفس الدومين مسموح تلقائيًا)
# GEMINI_MAX_OUTPUT_TOKENS=400

# ===== إشعارات Web Push (الخادم فقط) =====
# توليد المفاتيح مرة واحدة:  npx web-push generate-vapid-keys   (لا تضع القيم في Git)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# VAPID_SUBJECT مثال: mailto:admin@your-domain.example
