# أسماء المتغيرات فقط — لا تضع قيمًا حقيقية في المستودع.
# Vercel: Project ← Settings ← Environment Variables. غيابها يُفشل بناء الإنتاج عمدًا.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# مفتاح anon / publishable فقط (عام ومحمي بـ RLS). ممنوع service_role / sb_secret_.
SUPABASE_ANON_KEY=
# محليًا فقط: RAZI_DEMO=1 يُظهر بيانات تجريبية مع شريط أحمر. ممنوع في Vercel (يُفشل البناء).
# RAZI_DEMO=1

# اختبار التكامل (tests/supabase.integration.mjs) على مشروع Supabase *اختباري* فقط — من البيئة، لا من الملفات:
# TEST_ADMIN_EMAIL=  TEST_ADMIN_PASSWORD=  TEST_USER_EMAIL=  TEST_USER_PASSWORD=
